# Base URL of the Rezure API, including the /api/v1 version prefix.
# The download page reads GET {VITE_REZURE_API_BASE}/version/latest to show the latest release.
# Leave unset and the download page falls back to the GitHub releases link.
VITE_REZURE_API_BASE=http://localhost:8000/api/v1

# Hostnames (comma separated) where the website analytics tracker reports to
# POST {VITE_REZURE_API_BASE}/site/hit. Anywhere else — docs:dev, docs:preview,
# preview deploys — it stays off. Defaults to rezure.redscale.my.id when unset.
# Owner opt-out for one browser: visit any page with ?rz_ignore=1 (?rz_ignore=0 undoes it).
VITE_REZURE_ANALYTICS_HOSTS=rezure.redscale.my.id

# Optional search engine ownership tokens, emitted as <meta> on every page. Only the content
# value of the tag each console gives you. Not needed if the domain is verified via DNS.
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=
